# AMD Agentic Hardware Co-Design Platform
# Environment Variables Configuration

# Gemini API Key (Primary AI Model)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fallback AI Model - Optional but recommended)
# Get your key from: https://console.groq.com/keys
# FREE unlimited usage with llama-3.1-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# Note: At least one API key (GEMINI or GROQ) must be configured
# If both are set, system will try Gemini first and fallback to Groq on errors
